<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CRM Training Simulator — Edición Avanzada</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
  :root {
    --bg: #f4f6f9;
    --card: #ffffff;
    --primary: #142b49;
    --primary-mid: #1e3a8a;
    --primary-light: #eff6ff;
    --accent: #0d9488;
    --accent-light: #f0fdfa;
    --danger: #dc2626;
    --danger-light: #fef2f2;
    --warn: #d97706;
    --warn-light: #fffbeb;
    --text: #1e293b;
    --muted: #64748b;
    --border: #e2e8f0;
    --radius: 14px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  }

  html, body {
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #app {
    width: 96%;
    max-width: 1040px;
    height: 93vh;
    max-height: 720px;
    background: var(--card);
    border-radius: var(--radius);
    box-shadow: 0 12px 35px rgba(15, 23, 42, 0.1);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
  }

  /* Header */
  header {
    padding: 13px 24px;
    background: linear-gradient(125deg, var(--primary), #24558a);
    color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
  }

  .header-title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.2px;
  }

  .header-sub {
    font-size: 0.75rem;
    opacity: 0.85;
  }

  .hud {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .badge {
    background: rgba(255, 255, 255, 0.16);
    padding: 4px 11px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .badge.score {
    background: var(--accent);
    color: #fff;
  }

  /* Screens */
  .screen {
    display: none;
    flex: 1;
    padding: 18px 26px;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: auto;
  }

  .screen.active {
    display: flex;
  }

  /* Typography & Layout */
  h2 {
    font-size: 1.18rem;
    color: var(--primary);
    margin-bottom: 4px;
  }

  p {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--text);
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin: 8px 0;
  }

  .box {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
  }

  .box.highlight {
    background: var(--primary-light);
    border-color: #bfdbfe;
  }

  .box.accent {
    background: var(--accent-light);
    border-color: #99f6e4;
  }

  .box.warn {
    background: var(--warn-light);
    border-color: #fde68a;
  }

  .box-title {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    margin-bottom: 5px;
    color: var(--primary);
  }

  .box.warn .box-title { color: var(--warn); }
  .box.accent .box-title { color: var(--accent); }

  /* Form & Buttons */
  .input-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
    max-width: 460px;
    margin: 6px auto;
    width: 100%;
  }

  input[type="text"], select {
    padding: 9px 13px;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    font-size: 0.88rem;
    outline: none;
    background: #fff;
    transition: border-color 0.2s;
  }

  input[type="text"]:focus, select:focus {
    border-color: var(--primary);
  }

  input[type="file"] {
    font-size: 0.78rem;
  }

  .btn {
    padding: 9px 18px;
    border: none;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.1s, opacity 0.2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .btn:hover:not(:disabled) {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .btn-sm { padding: 6px 12px; font-size: 0.78rem; }
  .btn-primary { background: var(--primary); color: #fff; }
  .btn-accent { background: var(--accent); color: #fff; }
  .btn-danger { background: var(--danger); color: #fff; }
  .btn-outline { background: #fff; border: 1.5px solid var(--border); color: var(--text); }

  .footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    border-top: 1px solid var(--border);
    flex-shrink: 0;
    gap: 10px;
  }

  /* Simulator Items */
  .req-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fff;
    border: 1px solid var(--border);
    padding: 8px 12px;
    border-radius: 8px;
    margin-bottom: 6px;
    gap: 10px;
  }

  .req-text {
    font-size: 0.81rem;
    flex: 1;
  }

  .req-controls {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .pill-btn {
    padding: 5px 10px;
    font-size: 0.75rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg);
    cursor: pointer;
    font-weight: 600;
  }

  .pill-btn.selected-ok { background: var(--accent); color: #fff; border-color: var(--accent); }
  .pill-btn.selected-fix { background: var(--warn); color: #fff; border-color: var(--warn); }

  /* Trivia Options */
  .options-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 6px 0;
  }

  .option-btn {
    text-align: left;
    padding: 9px 13px;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    background: #fff;
    font-size: 0.83rem;
    cursor: pointer;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .option-btn:hover:not(:disabled) {
    border-color: var(--primary);
    background: var(--primary-light);
  }

  .option-btn.selected {
    border-color: var(--primary);
    background: var(--primary-light);
    font-weight: 600;
  }

  .option-btn.correct {
    border-color: var(--accent);
    background: var(--accent-light);
    color: #065f46;
    font-weight: 600;
  }

  .option-btn.wrong {
    border-color: var(--danger);
    background: var(--danger-light);
    color: #991b1b;
  }

  .match-row {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 10px;
    align-items: center;
    margin-bottom: 6px;
    font-size: 0.81rem;
  }

  .feedback-banner {
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.8rem;
    line-height: 1.35;
    display: none;
    margin-top: 4px;
  }

  .feedback-banner.show { display: block; }
  .feedback-banner.ok { background: var(--accent-light); border: 1px solid #5eead4; color: #064e3b; }
  .feedback-banner.err { background: var(--danger-light); border: 1px solid #fca5a5; color: #7f1d1d; }

  /* Data Table & Ranking */
  .mini-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.76rem;
  }

  .mini-table th, .mini-table td {
    text-align: left;
    padding: 5px 8px;
    border-bottom: 1px solid var(--border);
  }

  .mini-table th {
    background: var(--bg);
    color: var(--muted);
    font-weight: 700;
  }

  .profile-card {
    background: linear-gradient(135deg, var(--primary) 0%, #1e40af 100%);
    color: #fff;
    padding: 13px 18px;
    border-radius: 12px;
  }

  /* Anti-cheat Overlay */
  #cheat-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.96);
    color: #fff;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 30px;
    z-index: 100;
  }

  #cheat-overlay.active { display: flex; }

  /* Modal Ranking */
  #ranking-modal {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.65);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 90;
  }

  #ranking-modal.active { display: flex; }

  .modal-card {
    background: #fff;
    border-radius: 14px;
    padding: 20px;
    width: 100%;
    max-width: 640px;
    max-height: 82vh;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (max-width: 740px) {
    .grid-2 { grid-template-columns: 1fr; }
    #app { height: 97vh; max-height: none; }
    .screen { padding: 14px 16px; }
  }
</style>
</head>
<body>

<div id="app">
  <!-- Header -->
  <header>
    <div>
      <div class="header-title">CRM Training Simulator</div>
      <div class="header-sub">Gestión de Clientes, Análisis de Datos y Toma de Decisiones</div>
    </div>
    <div class="hud">
      <button class="btn btn-sm btn-outline" style="background:rgba(255,255,255,0.14); color:#fff; border-color:rgba(255,255,255,0.3);" onclick="toggleRanking(true)">🏆 Ranking</button>
      <span class="badge" id="hud-role" style="display:none;">Rol</span>
      <span class="badge score" id="hud-score" style="display:none;">0 / 6 pts</span>
    </div>
  </header>

  <!-- SCREEN 0: INICIO -->
  <section class="screen active" id="screen-start">
    <div style="text-align:center; margin-top: 4px;">
      <h2>Simulador Ejecutivo de Gestión CRM</h2>
      <p style="max-width:680px; margin: 4px auto; color:var(--muted);">
        Ingresa tu nombre para recibir un <strong>rol estratégico</strong> y un <strong>escenario empresarial</strong>. Auditarás decisiones de servicio, analizarás métricas de clientes y resolverás 6 retos seleccionados de un banco de <strong>100 preguntas reales de CRM</strong>.
      </p>
    </div>

    <div class="input-group">
      <label for="student-name" style="font-size:0.82rem; font-weight:700;">Nombre completo del participante:</label>
      <input type="text" id="student-name" placeholder="Ej. Alejandro Restrepo" autocomplete="off">
      <button class="btn btn-primary" onclick="startSimulation()">▶ Comenzar Misión CRM</button>
    </div>

    <div class="grid-2" style="max-width:740px; margin: 0 auto; width:100%;">
      <div class="box highlight">
        <div class="box-title">📊 Competencias Evaluadas</div>
        <p style="font-size:0.79rem;">
          • <strong>Operación y Servicio:</strong> Manejo de reclamos, SLA y omnicanalidad.<br>
          • <strong>Analítica CRM:</strong> Retención, Churn, NPS, CLV y calidad de datos.<br>
          • <strong>Estrategia Comercial:</strong> Embudo de ventas, segmentación y gobierno.
        </p>
      </div>
      <div class="box warn">
        <div class="box-title">⚠️ Protocolo de Evaluación Activo</div>
        <p style="font-size:0.79rem;">
          Al iniciar se activará el <strong>control de integridad</strong>. Si cambias de pestaña, minimizas el navegador o sales de esta ventana antes de finalizar, <strong>la simulación será anulada automáticamente</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- SCREEN 1: CONTEXTO DEL ESCENARIO Y ROL -->
  <section class="screen" id="screen-context">
    <div>
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px;">
        <h2 id="ctx-scenario-title">Escenario Asignado</h2>
        <span class="badge" style="background:var(--primary-light); color:var(--primary);">Fase 1 de 3: Diagnóstico y Rol</span>
      </div>
      <p id="ctx-scenario-desc" style="margin-top:4px;"></p>
    </div>

    <div class="grid-2">
      <div class="box highlight">
        <div class="box-title">👤 Tu Rol Asignado: <span id="ctx-role-name"></span></div>
        <p id="ctx-role-mission" style="font-size:0.82rem;"></p>
      </div>
      <div class="box accent">
        <div class="box-title">🎯 Objetivo Crítico del Negocio</div>
        <p id="ctx-client-need" style="font-size:0.82rem;"></p>
      </div>
    </div>

    <div class="box">
      <div class="box-title">📐 Pilares de Decisión CRM</div>
      <p style="font-size:0.81rem;">
        Toda decisión debe respaldarse en: <strong>1) Calidad y privacidad del dato</strong> (sin duplicados y con consentimiento), <strong>2) Continuidad omnicanal</strong> (historial unificado), <strong>3) Medición por KPIs</strong> (retención, CSAT, conversión) y <strong>4) Acciones preventivas</strong>.
      </p>
    </div>

    <div class="footer-bar">
      <span style="font-size:0.78rem; color:var(--muted);">Analiza tu misión y pasa al laboratorio operativo.</span>
      <button class="btn btn-primary" onclick="goToScreen('screen-sim')">Ir al Laboratorio CRM →</button>
    </div>
  </section>

  <!-- SCREEN 2: TALLER PRÁCTICO + EXPLORADOR DE CLIENTES -->
  <section class="screen" id="screen-sim">
    <div>
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2>Laboratorio CRM: Auditoría Operativa y Base de Clientes</h2>
        <span class="badge" style="background:var(--primary-light); color:var(--primary);">Fase 2 de 3: Práctica</span>
      </div>
      <p style="font-size:0.8rem; color:var(--muted);">
        Audita las 3 acciones registradas en el CRM de tu empresa (<strong>Aprobar</strong> si cumple buenas prácticas o <strong>Corregir</strong> si viola políticas/datos) y revisa la muestra de clientes.
      </p>
    </div>

    <div class="grid-2" style="align-items:start; margin:4px 0;">
      <!-- Columna izquierda: Auditoría de casos CRM -->
      <div>
        <div id="sim-items-container"></div>
        <div id="sim-feedback" class="feedback-banner"></div>
      </div>

      <!-- Columna derecha: Explorador de Datos de Clientes (del Prototipo 1) -->
      <div class="box" style="padding:10px 12px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
          <div class="box-title" style="margin:0;">📂 Base de Clientes (<span id="client-count-lbl">0</span>)</div>
          <div style="display:flex; gap:5px;">
            <button class="btn btn-sm btn-outline" onclick="generateSampleCustomers(25)">↻ Generar Muestra</button>
            <label class="btn btn-sm btn-outline" style="cursor:pointer; margin:0;">
              📥 CSV/XLSX
              <input type="file" id="file-import" accept=".csv,.xlsx,.xls,.txt" style="display:none;" onchange="handleFileImport(event)">
            </label>
          </div>
        </div>
        <div id="data-summary-pills" style="display:flex; gap:6px; margin-bottom:6px; font-size:0.74rem;"></div>
        <div style="max-height:135px; overflow-y:auto; border:1px solid var(--border); border-radius:6px; background:#fff;">
          <table class="mini-table">
            <thead><tr><th>ID</th><th>Edad</th><th>Compras</th><th>Satisfacción</th></tr></thead>
            <tbody id="data-rows"></tbody>
          </table>
        </div>
        <div id="import-status" style="font-size:0.72rem; color:var(--muted); margin-top:4px;">Datos ficticios cargados para análisis de contexto.</div>
      </div>
    </div>

    <div class="footer-bar">
      <button class="btn btn-accent" id="btn-verify-sim" onclick="verifySimulation()">Verificar Auditoría CRM</button>
      <button class="btn btn-primary" id="btn-next-trivia" onclick="startTrivia()" disabled>Continuar a Retos de Evaluación (6) →</button>
    </div>
  </section>

  <!-- SCREEN 3: TRIVIA GAMIFICADA (6 RETOS DEL BANCO + DINÁMICAS VARIADAS) -->
  <section class="screen" id="screen-trivia">
    <div>
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2 id="q-header">Reto 1 de 6</h2>
        <span class="badge" style="background:var(--primary-light); color:var(--primary);" id="q-type-badge">Categoría</span>
      </div>
      <p id="q-prompt" style="font-weight:600; margin-top:6px; font-size:0.9rem;"></p>
    </div>

    <div id="q-body" style="flex:1; display:flex; flex-direction:column; justify-content:center; overflow-y:auto;"></div>

    <div id="q-feedback" class="feedback-banner"></div>

    <div class="footer-bar">
      <button class="btn btn-primary" id="btn-submit-q" onclick="submitAnswer()">Validar Respuesta</button>
      <button class="btn btn-accent" id="btn-next-q" onclick="nextQuestion()" style="display:none;">Siguiente Reto →</button>
    </div>
  </section>

  <!-- SCREEN 4: RESULTADOS FINALES Y DIAGNÓSTICO -->
  <section class="screen" id="screen-end">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <div>
        <h2>Acta de Cierre y Diagnóstico Ejecutivo CRM</h2>
        <p style="font-size:0.8rem; color:var(--muted);">Evaluación completada bajo protocolo de integridad.</p>
      </div>
      <button class="btn btn-sm btn-outline" onclick="toggleRanking(true)">🏆 Ver Tabla de Clasificación</button>
    </div>

    <div class="grid-2" style="margin:4px 0;">
      <div class="box">
        <div class="box-title">📋 Ficha del Evaluado</div>
        <p style="font-size:0.81rem;"><strong>Participante:</strong> <span id="end-name"></span></p>
        <p style="font-size:0.81rem;"><strong>Rol:</strong> <span id="end-role"></span></p>
        <p style="font-size:0.81rem;"><strong>Escenario:</strong> <span id="end-scenario"></span></p>
        <p style="font-size:0.81rem;"><strong>Clientes en base:</strong> <span id="end-clients"></span> registros</p>
      </div>
      <div class="box accent" style="display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center;">
        <div class="box-title">Puntuación Final Obtenida</div>
        <div style="font-size:2rem; font-weight:800; color:var(--primary);" id="end-score">0 / 6</div>
        <div style="font-size:0.8rem; font-weight:700; color:var(--accent);" id="end-percent">0% · Nivel</div>
      </div>
    </div>

    <div class="profile-card">
      <div style="font-size:0.72rem; text-transform:uppercase; letter-spacing:0.6px; opacity:0.85;">Perfil Profesional Diagnosticado</div>
      <div style="font-size:1.1rem; font-weight:700; margin:2px 0;" id="end-profile-title"></div>
      <p style="font-size:0.81rem; color:#f1f5f9;" id="end-profile-desc"></p>
    </div>

    <div class="footer-bar">
      <span style="font-size:0.76rem; color:var(--muted);">Tu resultado ha sido guardado en la clasificación local de este navegador.</span>
      <button class="btn btn-primary" onclick="resetAll()">Iniciar Nuevo Escenario</button>
    </div>
  </section>

  <!-- MODAL RANKING -->
  <div id="ranking-modal">
    <div class="modal-card">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2 style="margin:0;">🏆 Tabla de Clasificación CRM</h2>
        <button class="btn btn-sm btn-outline" onclick="toggleRanking(false)">✕ Cerrar</button>
      </div>
      <div style="overflow-y:auto; flex:1; border:1px solid var(--border); border-radius:8px;">
        <table class="mini-table">
          <thead><tr><th>#</th><th>Participante</th><th>Rol</th><th>Puntaje</th><th>Nivel CRM</th><th>Fecha</th></tr></thead>
          <tbody id="leaderboard-rows"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ANTI-CHEAT OVERLAY -->
  <div id="cheat-overlay">
    <div style="font-size:2.6rem; margin-bottom:10px;">🚫</div>
    <h2 style="color:#fca5a5; font-size:1.35rem; margin-bottom:8px;">Simulación anulada por abandono de ventana</h2>
    <p style="color:#e2e8f0; max-width:500px; margin-bottom:20px;">
      Se detectó un cambio de pestaña, minimización o pérdida de foco mientras la evaluación CRM estaba activa. Por seguridad académica, tu intento fue invalidado.
    </p>
    <button class="btn btn-danger" onclick="resetAll()">Reiniciar Simulación desde Cero</button>
  </div>
</div>

<script>
  const LEADERBOARD_KEY = 'crmTrainingLeaderboardV2';

  const ROLES = [
    {
      name: "Gerente de Operaciones CRM",
      mission: "Garantizar la continuidad omnicanal, el cumplimiento de acuerdos de nivel de servicio (SLA) y la depuración constante de registros duplicados."
    },
    {
      name: "Analista de Inteligencia y Fidelización",
      mission: "Transformar el historial transaccional y las encuestas (NPS/CSAT) en acciones concretas para reducir la tasa de abandono (Churn)."
    },
    {
      name: "Líder de Gobierno de Datos y Calidad",
      mission: "Asegurar que cada interacción comercial respete la privacidad, el consentimiento informado, la trazabilidad y los permisos por rol."
    }
  ];

  const SCENARIOS = [
    {
      title: "Retail Omnicanal 'MercadoVivo'",
      desc: "Una cadena comercial con tiendas físicas y comercio electrónico presenta aumento de reclamos por entregas tardías y registros duplicados entre su web y call center.",
      need: "Reducir la tasa de abandono trimestral del 18% al 10% unificando el historial de compras y priorizando casos urgentes.",
      simItems: [
        {
          id: "c1",
          text: "Caso #101: Un asesor unifica dos perfiles duplicados del mismo cliente tras verificar su documento e historial de compras.",
          valid: true,
          reason: "Correcto: depurar y unificar duplicados evita visión fragmentada y mejora la calidad de datos."
        },

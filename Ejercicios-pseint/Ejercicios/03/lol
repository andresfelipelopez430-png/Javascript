    {cat:'CSAT',q:'¿Qué mide normalmente CSAT?',o:['Satisfacción del cliente con una experiencia o interacción','Costo de adquisición','Duración de una oportunidad','Cantidad de prospectos'],a:0,why:'CSAT mide la satisfacción declarada respecto a un producto, servicio o interacción.'},
    {cat:'Satisfacción y lealtad',q:'¿Un cliente satisfecho necesariamente será leal?',o:['Sí, siempre','No; la satisfacción ayuda, pero también influyen precio, alternativas y contexto','Solo si compra diariamente','La satisfacción no tiene ninguna relación'],a:1,why:'La satisfacción influye en la relación, pero no garantiza por sí sola la lealtad.'},
    {cat:'Seguridad de cuenta',q:'¿Qué práctica mejora la seguridad de acceso al CRM?',o:['Autenticación multifactor y contraseñas individuales','Compartir una clave entre todo el equipo','Desactivar el cierre de sesión','Usar la misma contraseña en todos los servicios'],a:0,why:'La autenticación multifactor y las cuentas individuales reducen el riesgo de acceso indebido.'},
    {cat:'Datos sensibles',q:'Un archivo contiene información personal que no es necesaria para el análisis. ¿Qué conviene hacer?',o:['Excluirla o anonimizarla antes de procesar','Publicarla en el dashboard','Copiarla a todos los equipos','Mantenerla por curiosidad'],a:0,why:'La minimización de datos reduce la exposición de información que no se necesita.'}
  ];

  // State
  let state = {
    active: false,
    studentName: "",
    role: null,
    scenario: null,
    simChoices: {},
    simVerified: false,
    questions: [],
    qIndex: 0,
    score: 0,
    qLocked: false,
    selectedMulti: [],
    customers: []
  };

  function esc(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function shuffle(arr) {
    return [...arr].sort(() => Math.random() - 0.5);
  }

  function startSimulation() {
    const nameInput = document.getElementById("student-name").value.trim();
    if (nameInput.length < 3) {
      alert("Por favor, ingresa tu nombre completo para iniciar.");
      return;
    }

    state.studentName = nameInput;
    state.role = ROLES[Math.floor(Math.random() * ROLES.length)];
    state.scenario = SCENARIOS[Math.floor(Math.random() * SCENARIOS.length)];
    state.simChoices = {};
    state.simVerified = false;
    state.qIndex = 0;
    state.score = 0;
    state.qLocked = false;
    state.active = true;

    // Construir 6 preguntas: 4 aleatorias del banco CRM + 2 dinámicas especiales del escenario
    const randomBankQs = shuffle(BANK_100).slice(0, 4).map(item => ({
      type: `Banco CRM · ${item.cat}`,
      kind: "single",
      prompt: item.q,
      options: item.o,
      answer: item.a,
      rationale: item.why
    }));

    state.questions = [
      randomBankQs[0],
      randomBankQs[1],
      state.scenario.specialQuestions[0],
      randomBankQs[2],
      state.scenario.specialQuestions[1],
      randomBankQs[3]
    ];

    // HUD
    document.getElementById("hud-role").style.display = "inline-block";
    document.getElementById("hud-score").style.display = "inline-block";
    document.getElementById("hud-role").textContent = state.role.name;
    updateScoreHUD();

    // Contexto
    document.getElementById("ctx-scenario-title").textContent = state.scenario.title;
    document.getElementById("ctx-scenario-desc").textContent = state.scenario.desc;
    document.getElementById("ctx-role-name").textContent = state.role.name;
    document.getElementById("ctx-role-mission").textContent = state.role.mission;
    document.getElementById("ctx-client-need").textContent = state.scenario.need;

    buildSimItems();
    if (state.customers.length === 0) generateSampleCustomers(25);
    goToScreen("screen-context");
  }

  function goToScreen(id) {
    document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
    document.getElementById(id).classList.add("active");
  }

  function updateScoreHUD() {
    document.getElementById("hud-score").textContent = `${state.score} / 6 pts`;
  }

  // Laboratorio CRM (Simulador práctico)
  function buildSimItems() {
    const container = document.getElementById("sim-items-container");
    container.innerHTML = "";
    state.scenario.simItems.forEach((item, idx) => {
      const div = document.createElement("div");
      div.className = "req-item";
      div.innerHTML = `
        <div class="req-text"><strong>#${idx + 1}:</strong> ${item.text}</div>
        <div class="req-controls">
          <button class="pill-btn" id="btn-${item.id}-ok" onclick="selectSim('${item.id}', true)">✓ Aprobar</button>
          <button class="pill-btn" id="btn-${item.id}-fix" onclick="selectSim('${item.id}', false)">✗ Corregir</button>
        </div>
      `;
      container.appendChild(div);
    });
    document.getElementById("sim-feedback").className = "feedback-banner";
    document.getElementById("btn-next-trivia").disabled = true;
    document.getElementById("btn-verify-sim").disabled = false;
  }

  function selectSim(id, isOk) {
    if (state.simVerified) return;
    state.simChoices[id] = isOk;
    document.getElementById(`btn-${id}-ok`).className = "pill-btn" + (isOk ? " selected-ok" : "");
    document.getElementById(`btn-${id}-fix`).className = "pill-btn" + (!isOk ? " selected-fix" : "");
  }

  function verifySimulation() {
    const items = state.scenario.simItems;
    if (Object.keys(state.simChoices).length < items.length) {
      alert("Evalúa los 3 casos operativos antes de verificar.");
      return;
    }

    state.simVerified = true;
    let hits = 0;
    let notes = [];

    items.forEach((item, i) => {
      if (state.simChoices[item.id] === item.valid) {
        hits++;
      } else {
        notes.push(`<strong>Caso #${i + 1}:</strong> ${item.reason}`);
      }
    });

    const fb = document.getElementById("sim-feedback");
    if (hits === items.length) {
      fb.className = "feedback-banner ok show";
      fb.innerHTML = `<strong>¡Auditoría perfecta (3/3)!</strong> Identificaste correctamente las prácticas válidas y los riesgos operativos.`;
    } else {
      fb.className = "feedback-banner err show";
      fb.innerHTML = `<strong>Resultado (${hits}/3 aciertos):</strong> ${notes.join(" | ")}`;
    }

    document.getElementById("btn-verify-sim").disabled = true;
    document.getElementById("btn-next-trivia").disabled = false;
  }

  // Generador e Importador de Clientes
  function generateSampleCustomers(n) {
    state.customers = Array.from({ length: n }, (_, i) => ({
      id: `CLI-${String(i + 1).padStart(3, '0')}`,
      age: 20 + Math.floor(Math.random() * 48),
      purchases: 1 + Math.floor(Math.random() * 18),
      satisfaction: ['Alta', 'Media', 'Baja'][Math.floor(Math.random() * 3)]
    }));
    document.getElementById("import-status").textContent = `Muestra aleatoria generada (${n} clientes ficticios).`;
    renderCustomersTable();
  }

  function renderCustomersTable() {
    const list = state.customers;
    document.getElementById("client-count-lbl").textContent = list.length;
    const alta = list.filter(c => c.satisfaction === 'Alta').length;
    const baja = list.filter(c => c.satisfaction === 'Baja').length;
    const avgCompras = list.length ? (list.reduce((s, c) => s + c.purchases, 0) / list.length).toFixed(1) : 0;

    document.getElementById("data-summary-pills").innerHTML = `
      <span class="badge" style="background:var(--accent-light); color:#065f46;">Alta: ${alta}</span>
      <span class="badge" style="background:var(--danger-light); color:#991b1b;">Baja: ${baja}</span>
      <span class="badge" style="background:var(--primary-light); color:var(--primary);">Prom. Compras: ${avgCompras}</span>
    `;

    document.getElementById("data-rows").innerHTML = list.slice(0, 15).map(c => `
      <tr>
        <td>${esc(c.id)}</td>
        <td>${c.age}</td>
        <td>${c.purchases}</td>
        <td><strong>${esc(c.satisfaction)}</strong></td>
      </tr>
    `).join('');
  }

  async function handleFileImport(e) {
    const f = e.target.files[0];
    if (!f) return;
    const status = document.getElementById("import-status");
    try {
      let rows = [];
      if (/\.csv$|\.txt$/i.test(f.name)) {
        const txt = await f.text();
        const lines = txt.trim().split(/\r?\n/);
        const sep = lines[0].includes(';') ? ';' : ',';
        const h = lines.shift().split(sep).map(x => x.trim().replace(/^"|"$/g, ''));
        rows = lines.map(l => {
          const v = l.split(sep).map(x => x.trim().replace(/^"|"$/g, ''));
          return Object.fromEntries(h.map((k, i) => [k, v[i] ?? '']));
        });
      } else if (/\.xlsx?$/i.test(f.name)) {
        if (!window.XLSX) throw Error("Lector Excel no disponible sin internet.");
        const data = await f.arrayBuffer();
        const wb = XLSX.read(data, { type: 'array' });
        rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { defval: '' });
      }
      if (!rows.length) throw Error("Archivo vacío.");
      const keys = Object.keys(rows[0]);
      const find = (r, terms) => {
        const k = keys.find(x => terms.some(t => x.toLowerCase().replace(/[ _]/g, '').includes(t)));
        return k ? r[k] : '';
      };
      const parsed = rows.map((r, i) => ({
        id: find(r, ['id', 'codigo']) || `IMP-${i + 1}`,
        age: Number(find(r, ['edad', 'age'])) || 30,
        purchases: Number(find(r, ['compras', 'purchase', 'ventas'])) || 0,
        satisfaction: String(find(r, ['satisfaccion', 'satisfaction', 'nivel'])) || 'Media'
      }));
      state.customers = parsed;
      status.textContent = `Archivo "${f.name}" importado: ${parsed.length} registros.`;
      renderCustomersTable();
    } catch (err) {
      status.textContent = `Error al importar: ${err.message}`;
    }
  }

  // Evaluación Gamificada (6 Retos)
  function startTrivia() {
    state.qIndex = 0;
    renderQuestion();
    goToScreen("screen-trivia");
  }

  function renderQuestion() {
    const q = state.questions[state.qIndex];
    state.qLocked = false;
    state.selectedMulti = [];

    document.getElementById("q-header").textContent = `Reto ${state.qIndex + 1} de ${state.questions.length}`;
    document.getElementById("q-type-badge").textContent = q.type;
    document.getElementById("q-prompt").textContent = q.prompt;

    const fb = document.getElementById("q-feedback");
    fb.className = "feedback-banner";
    fb.innerHTML = "";

    document.getElementById("btn-submit-q").style.display = "inline-flex";
    document.getElementById("btn-next-q").style.display = "none";

    const body = document.getElementById("q-body");
    body.innerHTML = "";

    if (q.kind === "single") {
      const list = document.createElement("div");
      list.className = "options-list";
      q.options.forEach((opt, idx) => {
        const btn = document.createElement("button");
        btn.className = "option-btn";
        btn.dataset.idx = idx;
        btn.innerHTML = `<span><strong>${String.fromCharCode(65 + idx)}.</strong></span> <span>${opt}</span>`;
        btn.onclick = () => {
          if (state.qLocked) return;
          list.querySelectorAll(".option-btn").forEach(b => b.classList.remove("selected"));
          btn.classList.add("selected");
        };
        list.appendChild(btn);
      });
      body.appendChild(list);
    } else if (q.kind === "multi") {
      const list = document.createElement("div");
      list.className = "options-list";
      q.options.forEach((opt, idx) => {
        const btn = document.createElement("button");
        btn.className = "option-btn";
        btn.dataset.idx = idx;
        btn.innerHTML = `<span>☐</span> <span>${opt}</span>`;
        btn.onclick = () => {
          if (state.qLocked) return;
          if (state.selectedMulti.includes(idx)) {
            state.selectedMulti = state.selectedMulti.filter(i => i !== idx);
            btn.classList.remove("selected");
            btn.querySelector("span").textContent = "☐";
          } else {
            state.selectedMulti.push(idx);
            btn.classList.add("selected");
            btn.querySelector("span").textContent = "☑";
          }
        };
        list.appendChild(btn);
      });
      body.appendChild(list);
    } else if (q.kind === "match") {
      const wrap = document.createElement("div");
      q.pairs.forEach((pair, idx) => {
        const row = document.createElement("div");
        row.className = "match-row";
        const optsHtml = q.choices.map(c => `<option value="${c}">${c}</option>`).join("");
        row.innerHTML = `
          <div class="box" style="padding:7px 10px;">${pair.left}</div>
          <select id="match-sel-${idx}">
            <option value="">-- Selecciona concepto --</option>
            ${optsHtml}
          </select>
        `;
        wrap.appendChild(row);
      });
      body.appendChild(wrap);
    }
  }

  function submitAnswer() {
    if (state.qLocked) return;
    const q = state.questions[state.qIndex];
    let isCorrect = false;

    if (q.kind === "single") {
      const sel = document.querySelector("#q-body .option-btn.selected");
      if (!sel) {
        alert("Selecciona una opción antes de validar.");
        return;
      }
      const chosen = parseInt(sel.dataset.idx, 10);
      isCorrect = (chosen === q.answer);

      document.querySelectorAll("#q-body .option-btn").forEach((btn, idx) => {
        btn.disabled = true;
        if (idx === q.answer) btn.classList.add("correct");
        else if (idx === chosen && !isCorrect) btn.classList.add("wrong");
      });
    } else if (q.kind === "multi") {
      if (state.selectedMulti.length === 0) {
        alert("Selecciona al menos una opción.");
        return;
      }
      const sortedUser = [...state.selectedMulti].sort().join(",");
      const sortedAns = [...q.answer].sort().join(",");
      isCorrect = (sortedUser === sortedAns);

      document.querySelectorAll("#q-body .option-btn").forEach((btn, idx) => {
        btn.disabled = true;
        if (q.answer.includes(idx)) btn.classList.add("correct");
        else if (state.selectedMulti.includes(idx)) btn.classList.add("wrong");
      });
    } else if (q.kind === "match") {
      let allFilled = true;
      let allMatch = true;
      q.pairs.forEach((pair, idx) => {
        const sel = document.getElementById(`match-sel-${idx}`);
        if (!sel.value) allFilled = false;
        if (sel.value !== pair.right) allMatch = false;
      });
      if (!allFilled) {
        alert("Completa todas las asociaciones antes de validar.");
        return;
      }
      isCorrect = allMatch;
      q.pairs.forEach((pair, idx) => {
        const sel = document.getElementById(`match-sel-${idx}`);
        sel.disabled = true;
        sel.style.borderColor = (sel.value === pair.right) ? "var(--accent)" : "var(--danger)";
        sel.style.background = (sel.value === pair.right) ? "var(--accent-light)" : "var(--danger-light)";
      });
    }

    state.qLocked = true;
    if (isCorrect) {
      state.score++;
      updateScoreHUD();
    }

    const fb = document.getElementById("q-feedback");
    fb.className = `feedback-banner show ${isCorrect ? "ok" : "err"}`;
    fb.innerHTML = `<strong>${isCorrect ? "¡Correcto! (+1 punto)" : "Respuesta incorrecta."}</strong> ${q.rationale}`;

    document.getElementById("btn-submit-q").style.display = "none";
    const nextBtn = document.getElementById("btn-next-q");
    nextBtn.style.display = "inline-flex";
    nextBtn.textContent = (state.qIndex < state.questions.length - 1) ? "Siguiente Reto →" : "Ver Acta y Diagnóstico →";
  }

  function nextQuestion() {
    if (state.qIndex < state.questions.length - 1) {
      state.qIndex++;
      renderQuestion();
    } else {
      finishSimulation();
    }
  }

  function finishSimulation() {
    state.active = false;
    const total = state.questions.length;
    const pct = Math.round((state.score / total) * 100);

    let level = "";
    let title = "";
    let desc = "";

    if (pct >= 85) {
      level = "Gerente de CRM";
      title = "Estratega Omnicanal y Analítico (Dominio Experto)";
      desc = "Dominas la toma de decisiones basada en indicadores (CLV, Churn, NPS), la gobernabilidad del dato y la resolución proactiva de fricciones con el cliente.";
    } else if (pct >= 70) {
      level = "Supervisor de CRM";
      title = "Coordinador de Experiencia y Calidad (Nivel Competente)";
      desc = "Aplicas correctamente la priorización de casos, el seguimiento comercial y la supervisión operativa, con oportunidad de profundizar en analítica predictiva.";
    } else if (pct >= 50) {
      level = "Profesional de CRM";
      title = "Analista Operativo en Consolidación (Nivel Intermedio)";
      desc = "Comprendes el flujo de atención y registro de clientes, pero debes reforzar la interpretación de KPIs y controles de privacidad de datos.";
    } else {
      level = "Auxiliar de CRM";
      title = "Explorador de Gestión de Clientes (Nivel Inicial)";
      desc = "Es recomendable repasar los fundamentos del ciclo de vida del cliente, la depuración de duplicados y los acuerdos de nivel de servicio (SLA).";
    }

    saveLeaderboard({
      name: state.studentName,
      role: state.role.name,
      score: pct,
      level,
      date: new Date().toISOString()
    });

    document.getElementById("end-name").textContent = state.studentName;
    document.getElementById("end-role").textContent = state.role.name;
    document.getElementById("end-scenario").textContent = state.scenario.title;
    document.getElementById("end-clients").textContent = state.customers.length;
    document.getElementById("end-score").textContent = `${state.score} / ${total}`;
    document.getElementById("end-percent").textContent = `${pct}% de efectividad · ${level}`;
    document.getElementById("end-profile-title").textContent = title;
    document.getElementById("end-profile-desc").textContent = desc;

    goToScreen("screen-end");
  }

  // Leaderboard (localStorage)
  function getLeaderboard() {
    try { return JSON.parse(localStorage.getItem(LEADERBOARD_KEY) || '[]'); }
    catch { return []; }
  }

  function saveLeaderboard(entry) {
    const list = getLeaderboard();
    list.push(entry);
    list.sort((a, b) => b.score - a.score || new Date(a.date) - new Date(b.date));
    localStorage.setItem(LEADERBOARD_KEY, JSON.stringify(list));
  }

  function toggleRanking(show) {
    const modal = document.getElementById("ranking-modal");
    if (show) {
      const list = getLeaderboard();
      document.getElementById("leaderboard-rows").innerHTML = list.length
        ? list.map((r, i) => `
            <tr>
              <td><strong>#${i + 1}</strong></td>
              <td>${esc(r.name)}</td>
              <td>${esc(r.role)}</td>
              <td><strong>${r.score}%</strong></td>
              <td>${esc(r.level)}</td>
              <td>${new Date(r.date).toLocaleDateString('es-CO')}</td>
            </tr>`).join('')
        : '<tr><td colspan="6" style="text-align:center; padding:18px; color:var(--muted);">Aún no hay participantes registrados en este navegador.</td></tr>';
      modal.classList.add("active");
    } else {
      modal.classList.remove("active");
    }
  }

  // Anti-cheat
  function triggerAntiCheat() {
    if (!state.active) return;
    state.active = false;
    document.getElementById("cheat-overlay").classList.add("active");
  }

  document.addEventListener("visibilitychange", () => {
    if (document.hidden) triggerAntiCheat();
  });

  window.addEventListener("blur", () => {
    triggerAntiCheat();
  });

  function resetAll() {
    state.active = false;
    document.getElementById("cheat-overlay").classList.remove("active");
    document.getElementById("hud-role").style.display = "none";
    document.getElementById("hud-score").style.display = "none";
    document.getElementById("student-name").value = "";
    goToScreen("screen-start");
  }
</script>
</body>
